# Copy to .env and fill in. Without an API key the agent runs in deterministic offline mode.

# --- Option A: Google Gemini (free tier, via its OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# --- Option B: OpenAI (remove OPENAI_BASE_URL above) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OPENAI_TEMPERATURE=0.2
# OPENAI_TIMEOUT=60

# Force offline mode even if a key is set (1 = on)
AGENT_OFFLINE=0

# Simulate external API outages to demo error handling, e.g. "order_api:2" (first 2 calls fail),
# "order_api" (always fails) or "shipment_api"
# SIMULATE_API_FAILURE=
